{
  "name": "resume-wallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "supabase:test": "node scripts/test-supabase.js",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:local": "npx hardhat run scripts/test-contract-local.js --network hardhat",
    "deploy:local": "npx hardhat run scripts/deploy-resume-registry.js --network hardhat",
    "deploy:base-sepolia": "npx hardhat run scripts/deploy-resume-registry.js --network baseSepolia",
    "deploy:base": "npx hardhat run scripts/deploy-resume-registry.js --network baseMainnet",
    "transfer-ownership": "npx hardhat run scripts/transfer-ownership.js --network baseSepolia",
    "verify:base-sepolia": "npx hardhat verify --network baseSepolia",
    "verify:base": "npx hardhat verify --network baseMainnet",
    "payment:create": "node scripts/create-payment-wallet.js",
    "payment:address": "node -e \"require('dotenv').config({path:'.env.local'}); const {privateKeyToAccount} = require('viem/accounts'); const pk = process.env.X402_PAYMENT_PRIVATE_KEY || process.env.PRIVATE_KEY; if (!pk) { console.log('No payment wallet configured'); process.exit(1); } const normalized = pk.startsWith('0x') ? pk : '0x' + pk; const acc = privateKeyToAccount(normalized); console.log('Payment Wallet:', acc.address); console.log('BaseScan:', 'https://basescan.org/address/' + acc.address);\"",
    "payment:backup": "node scripts/backup-payment-wallet.js",
    "payment:test": "node scripts/test-x402-payment.js",
    "payment:test-team": "node scripts/test-team-format.js",
    "payment:list": "node scripts/list-payments.js",
    "payment:credits": "node scripts/check-credits.js"
  },
  "dependencies": {
    "@account-kit/core": "^4.64.0",
    "@account-kit/react": "^4.64.0",
    "@base-org/account": "^2.2.0",
    "@base-org/account-ui": "^1.0.1",
    "@coinbase/onchainkit": "^1.1.2",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.85.5",
    "alchemy-sdk": "^3.6.3",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.3.3",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.0.0",
    "jwks-rsa": "^3.2.0",
    "lucide-react": "^0.540.0",
    "nanoid": "^5.1.6",
    "next": "15.5.7",
    "pinata-web3": "^0.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-tsparticles": "^2.12.2",
    "resend": "^6.5.2",
    "tailwind-merge": "^3.3.1",
    "tsparticles-slim": "^2.12.0",
    "viem": "^2.37.1",
    "zod": "^4.0.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.19.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.0",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
