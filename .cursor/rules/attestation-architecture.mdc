## The interface

Defined in `src/lib/attestation-service.ts` (Phase 2 will create this — currently does not exist).

```typescript
export interface AttestationService {
  /**
   * Prove a specific fact about a candidate. Returns a verifiable artifact.
   * The fact MUST be derivable from data Storm has access to (block_* tables,
   * MVR results, employment verifications, etc.). The implementation chooses
   * how to render the proof: signed JWT today, ZK proof later.
   */
  proveFact(input: AttestationInput): Promise<Attestation>

  /**
   * Verify an attestation independently. Used by carrier UIs and any
   * third-party verification endpoints. Returns whether the proof is valid
   * and what fields were disclosed.
   */
  verifyAttestation(attestation: Attestation): Promise<VerificationResult>
}

export interface AttestationInput {
  candidateUserId: string
  factType: FactType  // see registry below
  parameters?: Record<string, unknown>  // optional fact-specific params
  audienceId?: string  // optional carrier scoping
}

export interface Attestation {
  id: string                              // UUID, persisted in `attestations` table
  factType: FactType
  factSummary: string                     // human-readable summary for UI
  disclosedFields: Record<string, unknown> // selectively-disclosed values
  issuedAt: string
  expiresAt?: string
  proof: ProofArtifact
}

export type ProofArtifact =
  | { kind: 'signed_jwt'; jwt: string; issuer: string }       // Phase 2
  | { kind: 'midnight_zk'; txHash: string; proofId: string }  // Phase 3 (future)

export interface VerificationResult {
  valid: boolean
  factType: FactType
  factSummary: string
  disclosedFields: Record<string, unknown>
  issuedAt: string
  issuer: string
  reason?: string  // populated when valid: false
}
```

