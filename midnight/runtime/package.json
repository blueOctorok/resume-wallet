{
  "name": "storm-midnight-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --error-on-fail && node scripts/link-ledger8-runtime.mjs",
    "compile": "compact compile ../../compact/mvr-clean-36/mvr-clean-36.compact managed/mvr-clean-36 && compact compile ../../compact/cdl-class-a/cdl-class-a.compact managed/cdl-class-a && compact compile ../../compact/previous-employer-verified/previous-employer-verified.compact managed/previous-employer-verified",
    "wallet:address": "tsx scripts/wallet-address.ts",
    "wallet:status": "tsx scripts/wallet-status.ts",
    "register-dust": "tsx scripts/register-dust.ts",
    "deploy": "tsx scripts/deploy-contract.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@scure/bip39": "^2.0.1",
    "buffer": "^6.0.3",
    "compact-runtime-ledger8": "npm:@midnight-ntwrk/compact-runtime@0.16.0",
    "dotenv": "^16.6.1",
    "patch-package": "8.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.2",
    "@midnight-ntwrk/platform-js": "3.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0"
  }
}
