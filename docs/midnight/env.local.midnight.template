# Copy these lines into .env.local (gitignored). P3.2 wallet + P3.3 attestation.
# Template only — never commit real mnemonics.

MIDNIGHT_NETWORK=preprod
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# Hosted (Fly) — after npm run midnight:proof-server:deploy:
# MIDNIGHT_PROOF_SERVER_URL=https://provven-midnight-proof.fly.dev
# MIDNIGHT_PROOF_SERVER_USER=prove
# MIDNIGHT_PROOF_SERVER_PASSWORD=
# (Legacy https://prove:pass@host still works; runtime strips userinfo.)
MIDNIGHT_NODE_RPC_URL=https://rpc.preprod.midnight.network
# Lace Preprod uses v4; v3 still works for some tooling — match your wallet if proofs fail to sync
# v4 per Preprod compatibility matrix
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Paste 24 words from Lace — spaces only, no commas. Quotes required (value contains spaces).
MIDNIGHT_WALLET_MNEMONIC="word1 word2 word3 ... word24"

# Leave signed-jwt until P3.3 ships midnight-attestation-service.ts
# ATTESTATION_BACKEND=midnight

# After npm run midnight:deploy — contract address on Preprod
# MIDNIGHT_CONTRACT_ADDRESS=

# Encrypts local Level private-state store (pick a strong local password)
MIDNIGHT_PRIVATE_STATE_PASSWORD=
