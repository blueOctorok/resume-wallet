# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Midnight P3.3 — compiled ZK artifacts + local deployment secrets
# Compiled artifact lives inside the runtime package so it shares one node_modules
# (and one WASM instance) with compact-js. Source .compact stays version-controlled.
/midnight/runtime/managed/
/midnight/deployment.json
/midnight/runtime/node_modules/
# Cached wallet sync state (block height + local state) for incremental re-sync.
# Contains wallet financial state — never commit.
/midnight/runtime/.wallet-cache/
# Local Midnight private-state LevelDB (encrypted contract private state).
# Regenerable per machine — never commit. Matches root + runtime cwd variants.
midnight-level-db/
next-env.d.ts
nul
