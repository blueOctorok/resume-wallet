# .env.local
# Database (we'll set this up with Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/driverappchain"

# Dynamic.xyz Wallet (you'll need to get these)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID="your_dynamic_env_id"

# Pinata IPFS (you'll need to get these)
PINATA_JWT="your_pinata_jwt"
PINATA_GATEWAY="your_pinata_gateway"

# Blockchain (you'll need to create a wallet and get RPC URLs)
NEXT_PUBLIC_CONTRACT_ADDRESS="0x..."
PRIVATE_KEY="your_deployer_private_key"
POLYGON_RPC_URL="https://polygon-rpc.com/"
MUMBAI_RPC_URL="https://rpc-mumbai.maticvigil.com/"

# NextAuth (generate a random secret)
NEXTAUTH_SECRET="your_nextauth_secret"
